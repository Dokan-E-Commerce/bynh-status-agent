# bynh-status-agent configuration (optional; BYNH_* environment variables override every key).
# Default location: /etc/bynh-status-agent/bynh-status-agent.toml (or pass --config PATH).
# deny_cidrs = ["169.254.169.254", "10.20.0.0/16"]   # never checked, even with allow_private

# The agent token from Settings → Agents. Prefer BYNH_TOKEN, token_file or the
# systemd credential over putting it here.
# token = "bynh_agt_…"
# token_file = "/run/secrets/bynh_token"

api_url = "https://api.bynh.io"
allow_private = false   # true for on-premise agents checking internal hosts
report_ip = true
send_hostname = true
concurrency = 64

# log = "info"          # or debug, warn, a filter such as "bynh_status_agent=debug"
# log_format = "human"  # or json
# ca_file = "/etc/bynh-status-agent/internal-ca.pem"

# Outbound proxy (http:// only). Without proxy_url, HTTPS_PROXY/HTTP_PROXY/NO_PROXY are used.
# proxy_url = "http://user:pass@proxy.corp:3128"
# no_proxy = "localhost, .corp.internal, 10.0.0.0/8"
# check_via_proxy = false   # true sends checks through the proxy too (requires allow_private = true)
